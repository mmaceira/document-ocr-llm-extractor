# Copy this file to .env and fill in your values
# All settings can be overridden via environment variables with the ALBARAN_ prefix

# OpenAI API Configuration
OPENAI_API_KEY=""
OPENAI_BASE_URL=""            # optional: OpenAI-compatible endpoint (e.g., LiteLLM, local server)

# LLM Settings (ALBARAN_ prefix)
ALBARAN_MODEL="gpt-4o-mini"
ALBARAN_JSON_STRICT="true"    # Use OpenAI strict JSON schema mode (falls back to json_object if unavailable)
ALBARAN_MAX_OUTPUT_TOKENS="2000"
ALBARAN_TEMPERATURE="0.0"     # 0.0 for deterministic output
ALBARAN_SEED="7"              # Random seed for reproducibility (set to null/empty to disable)

# OCR / Docling Settings
ALBARAN_DOCLING_GPU="false"   # Use GPU acceleration for OCR (requires CUDA)
ALBARAN_OCR_LANGS="spa,eng,cat"  # Comma-separated OCR languages
ALBARAN_DPI="300"             # DPI for PDF rendering and visualization
ALBARAN_IMAGES_SCALE="4.17"   # Image scaling factor (4.17 ≈ 300 DPI)
ALBARAN_DESKEW="true"         # Apply deskew correction to scanned pages
ALBARAN_BINARIZE="true"       # Apply binarization to scanned pages
ALBARAN_MAX_PAGES=""          # Maximum pages to process (empty/null for all pages)

# Output Settings
ALBARAN_OUTPUTS_DIR="outputs"
ALBARAN_REDACT_OUTPUT="false" # Redact sensitive information in output visualizations
